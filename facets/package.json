{
  "name": "@schemastud/facets",
  "version": "0.3.1",
  "description": "The schema-driven facets surface: a resource-agnostic filter/sort bar over the x-filter / x-sort vendor keywords, with injected transport, injected UI primitives, and an injected URL-state seam. Host-agnostic and grammar-blind — no vendor vocabulary, no bundled router or HTTP client. A frame-rung tracer for @schemastud/frame.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messages": "./messages.default.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "messages.default.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schemastud/facets.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@schemastud/combobox": "^0.2.0",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": ">=0.4.0",
    "react": ">=18",
    "@schemastud/messages": ">=0.1.0 <1"
  },
  "devDependencies": {
    "@schemastud/combobox": "github:schemastud/js#23d6f448bc981db6d6b86baecbc0f3902cb342eb&path:/combobox",
    "@schemastud/ui": "github:schemastud/js#868f3be704f6af5b4954562edba7533c7a8c5999&path:/ui",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "@schemastud/messages": "github:schemastud/js#91d2a7fdd508dbb2b60e6fcbed71bcbd7d00c2d1&path:/messages"
  },
  "schemastud": {
    "messages": {
      "version": 1,
      "catalog": "./messages"
    }
  }
}
