{
    "name": "@schemastud/ui",
    "version": "0.1.0",
    "description": "The portable foundation UI primitives: shadcn/Radix-derived Button, Badge, Card (+ parts), Dialog, Input, Label, Select, Switch, a dependency-free Popover, and a headless TanStack DataTable — all skinned by host-owned Tailwind theme tokens (zero hard-coded colors). The generic-UI dependency a rehomed component takes statically instead of importing app-local `@/components/*`.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/schemastud/ui.git"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint:imports": "node scripts/check-imports.mjs",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.0.0"
    },
    "peerDependencies": {
        "@radix-ui/react-dialog": "^1.1.0",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.0",
        "@radix-ui/react-tooltip": "^1.1.0",
        "@tanstack/react-table": "^8.20.0",
        "lucide-react": ">=0.4.0",
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@radix-ui/react-dialog": "^1.1.0",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.3.5",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tanstack/react-table": "^8.20.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.2.3",
        "jsdom": "^29.1.1",
        "lucide-react": "^0.525.0",
        "react": "^19.0.0",
        "react-dom": "^19.2.7",
        "tsup": "^8.5.1",
        "typescript": "^5.7.0",
        "vitest": "^4.1.10"
    }
}
