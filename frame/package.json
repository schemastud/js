{
  "name": "@schemastud/frame",
  "version": "0.3.0",
  "description": "The batteries-included schema-driven admin editor rung atop @schemastud/seam + @schemastud/facets: resource-blind ListShell + EditShell, a three-seam injection bundle (transport, design-system primitives, URL-state), layered slots, and a resolveColumns seam. The shell renders any resource from its schema + a thin manifest entry, with no per-resource UI code.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shadcn": {
      "types": "./dist/shadcn.d.ts",
      "import": "./dist/shadcn.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./cards": {
      "types": "./dist/cards.d.ts",
      "import": "./dist/cards.js"
    },
    "./picker": {
      "types": "./dist/picker.d.ts",
      "import": "./dist/picker.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "import": "./dist/vocabulary.js"
    },
    "./messages": "./messages.default.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "docs",
    "bin",
    "vocabulary.default.json",
    "messages.default.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schemastud/frame.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --project tsconfig.typecheck.json && tsc --project tsconfig.typecheck.registered.json",
    "export-list": "node scripts/export-list.mjs src/index.ts --write && for b in editor cards picker wire session; do node scripts/export-list.mjs src/subpaths/$b.ts --write; done",
    "frame:vocabulary": "tsup && node bin/frame-vocabulary.mjs --out vocabulary.default.json"
  },
  "peerDependencies": {
    "@rjsf/core": "^6.0.0",
    "@rjsf/shadcn": "^6.0.0",
    "@rjsf/utils": "^6.0.0",
    "@rjsf/validator-ajv8": "^6.0.0",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": ">=0.4.0",
    "react": ">=18",
    "react-dom": ">=18",
    "zustand": ">=4",
    "@schemastud/messages": ">=0.1.0 <1"
  },
  "dependencies": {
    "@schemastud/facets": "^0.3.0",
    "@schemastud/seam": "^0.3.0",
    "@schemastud/ui": "^0.2.0"
  },
  "devDependencies": {
    "@rjsf/core": "^6.0.0",
    "@rjsf/shadcn": "^6.0.0",
    "@rjsf/utils": "^6.0.0",
    "@rjsf/validator-ajv8": "^6.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14",
    "@schemastud/messages": "^0.2.0"
  },
  "bin": {
    "frame-vocabulary": "bin/frame-vocabulary.mjs"
  },
  "schemastud": {
    "messages": {
      "version": 1,
      "catalog": "./messages"
    }
  }
}
