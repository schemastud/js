{
    "name": "@schemastud/combobox",
    "version": "0.1.0",
    "description": "A host-agnostic async combobox: a searchable, debounced, keyboard-navigable select whose UI atoms (Popover, Input) are injected as props so it carries no design-system dependency. Fetches options through a caller-supplied search function — usable for navigation switchers, filter value pickers, or resource-ref widgets.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./messages": "./messages.default.json"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "messages.default.json"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/schemastud/combobox.git"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "@schemastud/messages": ">=0.1.0 <1"
    },
    "devDependencies": {
        "@schemastud/ui": "^0.1.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.0.0",
        "jsdom": "^29.1.1",
        "react": "^19.0.0",
        "react-dom": "^19.2.7",
        "tsup": "^8.5.1",
        "typescript": "^5.7.0",
        "vitest": "^4.1.10",
        "@schemastud/messages": "^0.1.0"
    },
    "schemastud": {
        "messages": {
            "version": 1,
            "catalog": "./messages"
        }
    }
}
