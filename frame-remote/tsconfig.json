{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@schemastud/messages": [
                "../messages/src/index.ts"
            ],
            "@schemastud/messages/react": [
                "../messages/src/react.tsx"
            ]
        }
    },
    "include": [
        "src"
    ]
}
